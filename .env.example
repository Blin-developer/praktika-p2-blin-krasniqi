# ==============================================================================
# PROJECT 02 — RESTAURANT FOOD ORDERING PLATFORM
# Environment Configuration Template
# ==============================================================================

# Application Meta
APP_NAME="GourmetExpress"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database Configuration (MySQL / MariaDB via XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=praktika_p2_food_ordering
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache
BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Real-time WebSockets (Laravel Reverb / Pusher compatible)
PUSHER_APP_ID=local_app_id
PUSHER_APP_KEY=local_app_key
PUSHER_APP_SECRET=local_app_secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=8080
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# Vite / Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_PUSHER_APP_KEY=local_app_key
VITE_PUSHER_HOST=127.0.0.1
VITE_PUSHER_PORT=8080
VITE_PUSHER_SCHEME=http
VITE_PUSHER_CLUSTER=mt1
